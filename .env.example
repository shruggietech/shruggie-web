# Environment Variables
# Copy this file to .env.local and fill in the values.
# See ShruggieTech_Website_Specification.md §10.2 for details.

# Google Analytics 4 measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager container ID (e.g., GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Public site URL (e.g., https://shruggie.tech)
NEXT_PUBLIC_SITE_URL=https://shruggie.tech

# Formspree form ID for contact form submission
NEXT_PUBLIC_FORMSPREE_ID=

# Firebase production web app (public client configuration)
# Local development should use the Firebase Emulator Suite, not production data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=shruggie-web.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=shruggie-web
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=shruggie-web.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=660220401300
NEXT_PUBLIC_FIREBASE_APP_ID=1:660220401300:web:9c1db908200c18e0458681

# Server-only CMS authorization. Never expose these values with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=shruggie-web
FIREBASE_STORAGE_BUCKET=shruggie-web.firebasestorage.app
CMS_EDITOR_EMAILS=
